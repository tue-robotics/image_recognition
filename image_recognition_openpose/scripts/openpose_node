#!/usr/bin/env python3
import os

import diagnostic_updater
import rclpy
from rclpy.executors import ExternalShutdownException
from rclpy.node import Node
from rclpy.qos import qos_profile_sensor_data
from cv_bridge import CvBridge, CvBridgeError
from sensor_msgs.msg import Image

from image_recognition_interfaces.msg import Recognitions
from image_recognition_interfaces.srv import Recognize
from image_recognition_openpose import OpenposeWrapper
from image_recognition_util import image_writer


class OpenposeNode(Node):
    def __init__(self):
        super().__init__("openpose")
        self._openpose_wrapper = OpenposeWrapper(
            self.declare_parameter("model_folder", os.path.expanduser('~/src/openpose/models')).value,
            self.declare_parameter("pose_model", "BODY_25").value,
            self.declare_parameter("net_input_size", "-1x368").value,
            self.declare_parameter("net_output_size", "-1x-1").value,
            self.declare_parameter("num_scales", 1).value,
            self.declare_parameter("scale_gap", 0.5).value,
            self.declare_parameter("num_gpu_start", 0).value,
            self.declare_parameter("overlay_alpha", 0.6).value,
            self.declare_parameter("python_path", "/usr/local/python/").value,
        )
        self._topic_save_images = self.declare_parameter("topic_save_images", False).value
        self._service_save_images = self.declare_parameter("service_save_images", True).value
        self._topic_publish_result_image = self.declare_parameter("topic_publish_result_image", True).value
        self._service_publish_result_image = self.declare_parameter("service_publish_result_image", True).value
        self._save_images_folder = os.path.expanduser(self.declare_parameter("save_images_folder", "/tmp/openpose").value)

        self._bridge = CvBridge()
        self._recognitions_publisher = self.create_publisher(Recognitions, "recognitions", 10)
        if self._topic_publish_result_image or self._service_publish_result_image:
            self._result_image_publisher = self.create_publisher(Image, "result_image", 10)
        self._image_subscriber = self.create_subscription(Image, "image", self._image_callback, qos_profile_sensor_data)
        self._service = self.create_service(Recognize, "recognize", self._recognize)
        self._updater = diagnostic_updater.Updater(self)
        self._updater.setHardwareID("none")
        self._updater.add(diagnostic_updater.Heartbeat())

    def _image_callback(self, image):
        recognitions = self._get_recognitions(image, self._topic_save_images, self._topic_publish_result_image)
        self._recognitions_publisher.publish(Recognitions(header=image.header, recognitions=recognitions))

    def _recognize(self, request, response):
        response.recognitions = self._get_recognitions(
            request.image, self._service_save_images, self._service_publish_result_image
        )
        return response

    def _get_recognitions(self, image_msg, save_images, publish_images):
        """
        Handles the recognition and publishes and stores the debug images (should be called in main thread)
        :param image_msg: Incoming image
        :param save_images: Whether to store the images
        :param publish_images: Whether to publish the images
        :return: The recognized recognitions
        """
        try:
            bgr_image = self._bridge.imgmsg_to_cv2(image_msg, "bgr8")
        except CvBridgeError as e:
            self.get_logger().error(f"Could not convert to OpenCV image: {e}")
            return []

        recognitions, result_image = self._openpose_wrapper.detect_poses(bgr_image)

        # Write images
        if save_images:
            image_writer.write_raw(self._save_images_folder, bgr_image)
            image_writer.write_raw(self._save_images_folder, result_image, "overlayed")

        if publish_images:
            self._result_image_publisher.publish(self._bridge.cv2_to_imgmsg(result_image, "bgr8"))

        # Service response
        return recognitions


def main():
    rclpy.init()
    try:
        node = OpenposeNode()
        try:
            # A single-threaded executor keeps model creation and inference on the same thread.
            rclpy.spin(node)
        finally:
            node.destroy_node()
    except (KeyboardInterrupt, ExternalShutdownException):
        pass
    finally:
        rclpy.try_shutdown()


if __name__ == "__main__":
    main()
