#!/usr/bin/env python3

import rclpy
from cv_bridge import CvBridge, CvBridgeError
from rclpy.executors import ExternalShutdownException
from rclpy.node import Node
from sensor_msgs.msg import RegionOfInterest

from image_recognition_color_extractor import ColorExtractor
from image_recognition_interfaces.msg import CategoryProbability, CategoricalDistribution, Recognition
from image_recognition_interfaces.srv import Recognize


class ColorExtractorNode(Node):
    def __init__(self):
        super().__init__('color_extractor')
        self._bridge = CvBridge()
        total_colors = self.declare_parameter('total_colors', 3).value
        dominant_range = self.declare_parameter('dominant_range', 10).value
        self._color_extractor = ColorExtractor(total_colors, dominant_range)
        self._service = self.create_service(Recognize, 'extract_color', self._extract_color)

    def _extract_color(self, request, response):
        try:
            image = self._bridge.imgmsg_to_cv2(request.image, 'bgr8')
            colors = self._color_extractor.recognize(image)
        except (CvBridgeError, RuntimeError, ValueError) as error:
            self.get_logger().error(f'Color extraction failed: {error}')
            return response

        response.recognitions = [Recognition(
            categorical_distribution=CategoricalDistribution(
                probabilities=[
                    CategoryProbability(label=label, probability=float(percentage) / 100.0)
                    for label, percentage in colors
                ],
            ),
            roi=RegionOfInterest(width=request.image.width, height=request.image.height),
        )]
        return response


def main():
    rclpy.init()
    try:
        node = ColorExtractorNode()
        try:
            rclpy.spin(node)
        finally:
            node.destroy_node()
    except (KeyboardInterrupt, ExternalShutdownException):
        pass
    finally:
        rclpy.try_shutdown()


if __name__ == '__main__':
    main()
