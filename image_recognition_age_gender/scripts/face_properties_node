#!/usr/bin/env python3
import os

import diagnostic_updater
import rclpy
from rclpy.executors import ExternalShutdownException
from rclpy.node import Node
from cv_bridge import CvBridge, CvBridgeError
from image_recognition_age_gender.age_gender_estimator import AgeGenderEstimator
from image_recognition_interfaces.msg import FaceProperties
from image_recognition_interfaces.srv import GetFaceProperties
from image_recognition_util import image_writer


class FacePropertiesNode(Node):
    def __init__(self):
        """
        ROS node that wraps the PyTorch age gender estimator
        """
        super().__init__('face_properties')
        default_weights_path = os.path.expanduser('~/data/pytorch_models/best-epoch47-0.9314.onnx')
        weights_file_path = os.path.expanduser(self.declare_parameter('weights_file_path', default_weights_path).value)
        img_size = self.declare_parameter('image_size', 64).value
        save_images = self.declare_parameter('save_images', True).value
        save_images_folder = self.declare_parameter('save_images_folder', '/tmp/image_recognition_pytorch').value
        use_gpu = self.declare_parameter('use_gpu', False).value
        self._bridge = CvBridge()
        self._estimator = AgeGenderEstimator(weights_file_path, img_size, use_gpu)

        if save_images and save_images_folder:
            self._save_images_folder = os.path.expanduser(save_images_folder)
            if not os.path.exists(self._save_images_folder):
                os.makedirs(self._save_images_folder)
        else:
            self._save_images_folder = None

        self._properties_srv = self.create_service(GetFaceProperties, 'get_face_properties', self._get_face_properties)
        self._updater = diagnostic_updater.Updater(self)
        self._updater.setHardwareID('none')
        self._updater.add(diagnostic_updater.Heartbeat())
        self.get_logger().info(f'Loaded {weights_file_path} (image size {img_size}, GPU {use_gpu})')

    def _get_face_properties(self, req, response):
        # Convert to opencv images
        try:
            bgr_images = [self._bridge.imgmsg_to_cv2(image, "bgr8") for image in req.face_image_array]
        except CvBridgeError as e:
            self.get_logger().error(f"Could not convert image to OpenCV: {e}")
            return response

        if not bgr_images:
            return response
        self.get_logger().info(f"Estimating properties of {len(bgr_images)} incoming images")
        estimations = self._estimator.estimate(bgr_images)

        face_properties_array = []
        for (age, gender_prob) in estimations:
            gender, gender_confidence = (FaceProperties.FEMALE, gender_prob[0]) if gender_prob[0] > 0.5 else (FaceProperties.MALE, gender_prob[1])

            face_properties_array.append(FaceProperties(
                age=int(age),
                gender=gender,
                gender_confidence=float(gender_confidence)
            ))

        # Store images if specified
        if self._save_images_folder:
            def _get_label(p):
                return "age_%d_gender_%s" % (p.age, "male" if p.gender == FaceProperties.MALE else "female")

            image_writer.write_estimations(self._save_images_folder, bgr_images,
                                           [_get_label(p) for p in face_properties_array],
                                           suffix="_face_properties")

        # Service response
        response.properties_array = face_properties_array
        return response


def main():
    rclpy.init()
    try:
        node = FacePropertiesNode()
        try:
            rclpy.spin(node)
        finally:
            node.destroy_node()
    except (KeyboardInterrupt, ExternalShutdownException):
        pass
    finally:
        rclpy.try_shutdown()


if __name__ == '__main__':
    main()
