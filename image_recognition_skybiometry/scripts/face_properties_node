#!/usr/bin/env python3
import rclpy
from rclpy.executors import ExternalShutdownException
from rclpy.node import Node
from cv_bridge import CvBridge, CvBridgeError
import diagnostic_updater

from image_recognition_interfaces.srv import GetFaceProperties
from image_recognition_interfaces.msg import FaceProperties
from image_recognition_util import image_writer
from image_recognition_skybiometry import Skybiometry

import os


class SkybiometryFaceProperties(Node):
    def __init__(self):
        super().__init__('face_properties')
        key = self.declare_parameter('api_key', os.environ.get('SKYBIOMETRY_API_KEY', '')).value
        secret = self.declare_parameter('api_secret', os.environ.get('SKYBIOMETRY_API_SECRET', '')).value
        if not key or not secret:
            raise ValueError('Set Skybiometry credentials through the environment or ROS parameters')
        namespace = self.declare_parameter('namespace', 'techunited').value
        timeout = self.declare_parameter('api_timeout', 10).value
        save_images = self.declare_parameter('save_images', True).value
        save_images_folder = self.declare_parameter('save_images_folder', '/tmp/skybiometry').value
        self._bridge = CvBridge()
        self._skybiometry = Skybiometry(key, secret, namespace)
        self._api_timeout = timeout

        if save_images and save_images_folder:
            self._save_images_folder = os.path.expanduser(save_images_folder)
            if not os.path.exists(self._save_images_folder):
                os.makedirs(self._save_images_folder)
        else:
            self._save_images_folder = None

        self._properties_srv = self.create_service(GetFaceProperties, 'get_face_properties', self._get_face_properties_srv)
        self._updater = diagnostic_updater.Updater(self)
        self._updater.setHardwareID('none')
        self._updater.add(diagnostic_updater.Heartbeat())

    def _get_face_properties_srv(self, req, response):
        """
        Callback when the GetFaceProperties service is called

        :param req: Input image
        :return: properties
        """
        # Convert to opencv images
        try:
            bgr_images = [self._bridge.imgmsg_to_cv2(image, "bgr8") for image in req.face_image_array]
        except CvBridgeError as e:
            self.get_logger().error(f"Could not convert image to OpenCV: {e}")
            return response

        # Call the Skybiometry API
        if not bgr_images:
            return response
        self.get_logger().info(f"Trying Skybiometry API request for {self._api_timeout} seconds")
        sky_face_properties_array = self._skybiometry.get_face_properties(bgr_images, self._api_timeout)

        face_properties_array = []
        for sky_face_properties in sky_face_properties_array:
            face_properties_array.append(FaceProperties(
                gender=FaceProperties.MALE if sky_face_properties.gender.value == "male" else FaceProperties.FEMALE,
                gender_confidence=float(sky_face_properties.gender.confidence),
                age=int(sky_face_properties.age_est.value)
            ))

        # Store images if specified
        if self._save_images_folder:
            def _get_label(p):
                return "age_%d_gender_%s" % (p.age, "male" if p.gender == FaceProperties.MALE else "female")

            image_writer.write_estimations(self._save_images_folder, bgr_images,
                                           [_get_label(p) for p in face_properties_array],
                                           suffix="_face_properties")

        # Service response
        response.properties_array = face_properties_array
        return response


def main():
    rclpy.init()
    try:
        node = SkybiometryFaceProperties()
        try:
            rclpy.spin(node)
        finally:
            node.destroy_node()
    except (KeyboardInterrupt, ExternalShutdownException):
        pass
    finally:
        rclpy.try_shutdown()


if __name__ == '__main__':
    main()
