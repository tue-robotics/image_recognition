#!/usr/bin/env python3
import argparse
import os
from image_recognition_skybiometry import Skybiometry
import cv2

# Assign description to the help doc
parser = argparse.ArgumentParser(description='Get face properties using the Skybiometry API')

# Add arguments
parser.add_argument(
    '-i', '--image', type=str, help='Image', required=True)
parser.add_argument(
    '-k', '--key', type=str, help='API Key', required=False, default=os.environ.get('SKYBIOMETRY_API_KEY'))
parser.add_argument(
    '-s', '--secret', type=str, help='API Secret', required=False, default=os.environ.get('SKYBIOMETRY_API_SECRET'))
parser.add_argument(
    '-n', '--namespace', type=str, help='Namespace', required=False, default='techunited')
parser.add_argument(
    '-t', '--timeout', type=int, help='Timeout in seconds', required=False, default=10)
parser.add_argument(
    '-v', '--verbose', help="Increase output verbosity", action="store_true")
args = parser.parse_args()
if not args.key or not args.secret:
    parser.error('Set SKYBIOMETRY_API_KEY and SKYBIOMETRY_API_SECRET or pass --key and --secret')

# Read the image
img = cv2.imread(args.image)

# Create Skybiometry interface
s = Skybiometry(args.key, args.secret, args.namespace)

if args.verbose:
    print("Trying Skybiometry API request for %d seconds" % args.timeout)

# Pretty print the output
try:
    print(s.get_face_properties([img], args.timeout))
except Exception as e:
    print("An error occurred: %s" % e)